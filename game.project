[project]
title = Evergon Battler
developer = Jeff Igusa
custom_resources = res/
dependencies#0 = https://github.com/britzl/defold-richtext/archive/refs/tags/5.22.1.zip
dependencies#1 = https://github.com/subsoap/defos/archive/refs/tags/v2.8.7.zip


[bootstrap]
main_collection = /main/main.collectionc
render = /main/render/custom_render.renderc

[input]
game_binding = /input/game.input_bindingc
use_accelerometer = 0

[display]
width = 1920
height = 1080
high_dpi = 1

[script]
shared_state = 1

[windows]
app_icon = /assets/app_icons/appicon.ico

[osx]
app_icon = /assets/app_icons/appicon.icns

[android]
input_method = HiddenInputField

[physics]
gravity_y = -1000.0
scale = 0.01
velocity_threshold = 100.0

[html5]
scale_mode = stretch

