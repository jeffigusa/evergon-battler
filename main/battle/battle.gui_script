local utils = require 'main.utils.basic_utils'
local gui_utils = require 'main.utils.gui_utils'
local bars = require 'main.utils.bars'
local Unit = require 'main.unit.unit'
local Battle = require 'main.battle.battle'
local Player = require 'main.player.player'
local Enemy = require 'main.enemy.enemy'
local Terrain = require 'main.battle.terrain'
local urls = require 'main.urls'

local M
M = {
	display = {},
	get_display = function(id) return utils.search(M.display, function(v) return v.id == id end) end,
	remove_display = function(id) utils.remove(M.display, id, 'id', 1) end,
	add_unit = function(unit)
		local unit_data = Unit.get_data(unit.prototype)
		local template = gui.get_node('unit_template/node')
		local tree = gui.clone_tree(template)
		local node = tree['unit_template/node']
		local hp_bar = tree['unit_template/hp']
		local hp_bar_fill = tree['unit_template/hp_fill']
		local bar = bars.new(hp_bar, hp_bar_fill, nil, unit.hp, unit.max_hp)
		local stance = tree['unit_template/stance']
		if unit.hp == unit.max_hp then bar.hide() end
		if Unit.has_status('wounded', unit) then
			gui.set_color(hp_bar_fill, vmath.vector4(0.8, 0, 0.8, 1))
		end
		table.insert(M.display, {id=unit.id, node=node, bar=bar, stance=stance})

		gui.set_id(node, unit.id)
		gui.set_position(node, unit.position)
		if unit.team == 'enemy' then gui.set_color(node, vmath.vector4(0.7,0.7,0.7, 1)) end
		
		gui.set_texture(node, 'units')
		gui_utils.set_texture_with_default_placeholder(node, 'units', unit.prototype..'_idle', '_placeholder')

		if hash(unit.team) == hash('player') then
			M.update_z()
			-- set stance icon
			gui.set_visible(stance, true)
			gui_utils.set_texture_with_default_placeholder(stance, 'icons', unit.stance, '_placeholder')
		end
	end,
	move_unit = function(unit)
		local node = gui.get_node(unit.id)
		gui.set_position(node, unit.position)
	end,
	set_unit_facing = function(unit)
		local display = M.get_display(unit.id)
		local node = display.node
		local bar = display.bar
		if hash(unit.facing) == hash('right') then
			local euler = 0
			gui.set(node, 'euler.y', euler)
			gui.set(bar.node, 'euler.y', euler)
		elseif hash(unit.facing) == hash('left') then
			local euler = 180
			gui.set(node, 'euler.y', euler)
			gui.set(bar.node, 'euler.y', euler)
		end
	end,
	defeat_unit = function(unit)
		-- play death animation here
		M.remove_unit(unit)
	end,
	remove_unit = function(unit)
		local display = M.get_display(unit.id)
		gui.delete_node(display.node)
		M.remove_display(unit.id)
	end,
	cancel_unit_attack = function(unit)
		local unit_data = Unit.get_data(unit.prototype)
		local node = gui.get_node(unit.id)
		gui.cancel_flipbook(node)
		gui_utils.set_texture_with_default_placeholder(node, 'units', unit.prototype..'_idle', '_placeholder')
	end,
	show_unit_attack = function(unit)
		local unit_data = Unit.get_data(unit.prototype)
		local initial_target = unit.target
		local node = gui.get_node(unit.id)
		local defender = Battle.get_unit(unit.target)
		if not defender or defender.hp <= 0 then return end
		if pcall(gui.play_flipbook, node, unit.prototype..'_attack') then
			gui.play_flipbook(node, unit.prototype..'_attack', function()
				gui_utils.set_texture_with_default_placeholder(node, 'units', unit.prototype..'_idle', '_placeholder')
			end)
			if unit_data.is_ranged then
				local defender_node = gui.get_node(unit.target)
				local target_position = gui.get_position(defender_node)
				timer.delay(1/unit_data.attack_speed/2, false, function()
					local attacker_now = Battle.get_unit(unit.id)
					if not attacker_now or not defender
						or attacker_now.hp <=0 or defender.hp <= 0
						or hash(attacker_now.state) ~= hash('attacking')
						or defender.id ~= initial_target then
							return
					end
					local offset = target_position - unit.position
					local angle = math.atan2(offset.y, offset.x)
					local rotation = vmath.quat_rotation_z(angle)
					if pcall(gui.get_position, defender_node) then target_position = gui.get_position(defender_node) end
					local projectile_node = gui.new_box_node(vmath.vector3(), vmath.vector3(30))
					gui.set_rotation(projectile_node, rotation)
					gui_utils.set_texture_with_default_placeholder(projectile_node, 'units', unit.prototype..'_projectile', '_placeholder')
					local duration = vmath.length(offset)/unit_data.projectile_speed
					gui.set_parent(projectile_node, gui.get_node('map'))
					gui.set_position(projectile_node, unit.position)
					gui.animate(projectile_node, 'position', target_position, gui.EASING_LINEAR, duration, 0, function()
						gui.delete_node(projectile_node)
					end)
				end)
			end
		end
	end,
	take_dmg = function(unit, dmg)
		local display = M.get_display(unit.id)
		local node = display.node
		if unit.hp ~= unit.max_hp then display.bar.show() end
		display.bar.set_fill(unit.hp)
		local euler = 10
		gui.cancel_animations(node, 'euler.z')
		gui.set(node, 'euler.z', euler)
		gui.animate(node, 'euler.z', 0, gui.EASING_INCUBIC, 0.1)

	end,
	update_z = function()
		local nodes = {}
		for i, v in ipairs(M.display) do
			local node = v.node
			local position = gui.get_position(node)
			table.insert(nodes, {node=node, y=position.y})
		end
		table.sort(nodes, function(a, b) return a.y > b.y end)
		for i = 2, #nodes do
			gui.move_above(nodes[i].node, nodes[i-1].node)
		end
	end,
	hide_stances = function()
		for i, v in ipairs(M.display) do
			if v.stance then gui.set_visible(v.stance, false) end
		end
	end,
	add_terrain = function(terrain)
		local node = gui.new_box_node(vmath.vector3(terrain.x, terrain.y, 0), vmath.vector3(terrain.w, terrain.h, 0))
		gui.set_parent(node, gui.get_node('map'))
		local display = {node=node, id=terrain.id}
		gui_utils.set_texture_with_default_placeholder(node, 'terrain', terrain.prototype, '_placeholder')
		table.insert(M.display, display)
	end
}

local set_enemies = function()
	local enemy_party = Enemy.get_random_party(Player.day)
	for i, v in ipairs(enemy_party) do
		v.facing = 'left'
		v.stance = 'aggressive'
		Battle.add_unit(v)
		M.add_unit(v)
		M.set_unit_facing(v)
	end
end

local set_terrains = function()
	local terrains = Terrain.get_random_terrains()
	for i, terrain in ipairs(terrains) do
		Battle.add_terrain(terrain)
		M.add_terrain(terrain)
	end
end

function init(self)
	math.randomseed(os.time())

	set_enemies()
	set_terrains()

	M.update_z()


	-- increase timescale for testing
	-- msg.post(urls.battle, 'set_time_step', {factor = 3, mode=0})
end

function update(selt, dt)
	if Battle.combat_started then M.update_z() end
	Battle.tick_combat(dt)
end

function on_message(self, message_id, message, sender)
	if message_id == hash('unit_added') then
		M.add_unit(message.unit)
	elseif message_id == hash('unit_removed') then
		M.remove_unit(message.unit)
	elseif message_id == hash('unit_moved') then
		M.move_unit(message.unit)
	elseif message_id == hash('unit_facing') then
		M.set_unit_facing(message.unit)
	elseif message_id == hash('unit_attacked') then
		M.show_unit_attack(message.unit)
	elseif message_id == hash('unit_attack_cancelled') then
		M.cancel_unit_attack(message.unit)
	elseif message_id == hash('unit_defeated') then
		M.defeat_unit(message.unit)
	elseif message_id == hash('unit_took_dmg') then
		M.take_dmg(message.unit, message.dmg)
	elseif message_id == hash('hide_stances') then
		M.hide_stances()

	elseif message_id == hash('terrain_added') then
		M.add_terrain(message.terrain)
	end
end